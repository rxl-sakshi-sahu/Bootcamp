Comparator - (interface for custom sort based on +ve, -ve and 0 value of compare function)

class MyComparator implements Comparator<Integer>{
@Override

public int compare(Integer o1, Integer o2){  // agar int compare me int -ve aata h to o1 comes before, and vice versa
	return o1-o2;  // ascending (-ve)
	}
}


list.sort(new MyComparator());

// OR SIMPLY USE LAMBDA EXPRESSION as Comparator is functional interface

list.sort((a,b) -> a-b) // for asc 
list.sort((a,b)-> b - a) // for desc


